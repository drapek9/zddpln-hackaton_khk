# Copy to .env (never commit .env). Values here are placeholders only.

# Backend
CESTY_DB_URL=sqlite:///./backend/cesty.db
CESTY_SECRET_KEY=change-me-dev-only
# Web and API share one origin through Vite, so this list is unused in the demo.
# Set it only if a browser calls the API on another host.
CESTY_CORS_ORIGINS=http://localhost:5173
# 1 on the HTTPS tunnel (Secure cookie). start-server.command sets this when a tunnel will run.
# Leave 0 for plain HTTP on the local network (NO_TUNNEL=1).
CESTY_COOKIE_SECURE=0

# Fill CESTY_SEED_*_PASSWORD before the first start. Empty values are printed once, only when the empty database is created.
CESTY_SEED_ADMIN_PASSWORD=
CESTY_SEED_OFFICIAL_PASSWORD=
CESTY_SEED_CITIZEN_PASSWORD=

# AI (optional, app works without it). The key stays empty here.
# Groq, two models, one key: https://console.groq.com/keys
# Docs: https://console.groq.com/docs/openai
# Limits (per model): https://console.groq.com/docs/rate-limits
# anthropic does not need AI_ENDPOINT. groq does.
AI_PROVIDER=groq
AI_API_KEY=
AI_ENDPOINT=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_MODEL_FALLBACK=openai/gpt-oss-20b

# Web Push. Generate once: cd backend && uv run python -m app.notify.vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tym@example.com

# E-mail fallback (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
